/*
 * ╔══════════════════════════════════════════════════════════════════════════╗
 * ║                    Tavomak's CORNE KEYMAP CONFIGURATION                  ║
 * ╠══════════════════════════════════════════════════════════════════════════╣
 * ║  5 layers: BASE · NUMBER · SYMBOL · FUNCTION · SETTINGS                 ║
 * ║  OS: macOS Spanish (Spain) — keycodes derived accordingly                ║
 * ║  Specs: .claude/specs/01–07                                              ║
 * ╚══════════════════════════════════════════════════════════════════════════╝
 */

// ============================================================================
// MOUSE CONFIG
// ============================================================================
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

// ============================================================================
// INCLUDES
// ============================================================================
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// ============================================================================
// INPUT PROCESSORS
// ============================================================================
&mmv_input_listener {
    input-processors = <&zip_xy_scaler 2 1>;
};

&msc_input_listener {
    input-processors = <&zip_scroll_scaler 2 1>;
};

// ============================================================================
// MOUSE SCROLL
// ============================================================================
&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

// ============================================================================
// MOUSE MOVEMENT
// ============================================================================
&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {

    // ========================================================================
    // MACROS — spec 07
    // ========================================================================
    macros {

        // => (JS arrow function)
        // Sends = then > under Spanish macOS
        macro_arrow: macro_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LS(N0)>, <&kp LS(NON_US_BSLH)>;
        };

        // {} with cursor inside (JS/CSS block)
        // Sends { then } then LEFT arrow
        macro_block: macro_block {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LA(SQT)>, <&kp LA(BSLH)>, <&kp LEFT>;
        };
    };

    // ========================================================================
    // BEHAVIORS — specs 02, 06
    // ========================================================================
    behaviors {

        // Tap = SHIFT / Hold = CTRL — spec 02
        // flavor=balanced + require-prior-idle avoids CTRL on fast typing
        mt_ctrl_shift: mt_ctrl_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // 1 tap = RSHIFT / 2 taps = CAPS_WORD — spec 06
        td_shift_caps: td_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHIFT>, <&caps_word>;
        };

        // 1 tap = ' / 2 taps = " — spec 06
        // MINUS = ' and LS(N2) = " under Spanish macOS
        td_quote: td_quote {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp MINUS>, <&kp LS(N2)>;
        };
    };

    // ========================================================================
    // ENCODERS
    // ========================================================================

    // RGB brightness (not used in any layer currently — available for future)
    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    // Scroll — used in layers 1-4
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    // ========================================================================
    // TRI-LAYER: NUMBER (1) + SYMBOL (2) → SETTINGS (4) — spec 03
    // ========================================================================
    conditional_layers {
        compatible = "zmk,conditional-layers";
        settings_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    // ========================================================================
    // KEYMAP
    // ========================================================================
    keymap {
        compatible = "zmk,keymap";

        // ====================================================================
        // LAYER 0: BASE — specs 01, 02
        // ====================================================================
        // Thumb left:  ALT | CMD | SPACE/FN
        // Thumb right: ENTER/FN | NUM | SYM
        // Pinky left:  ESC (top) | TAB (home) | CTRL/SHIFT (bottom)
        // Pinky right: BSPC (top) | ´ (home) | SHIFT/CAPS (bottom)
        // ====================================================================
        default_layer {
            display-name = "BASE";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ESC                Q                  W                  E                  R                  T                      Y                  U                  I                  O                  P                  BSPC
    &kp ESC            &kp Q              &kp W              &kp E              &kp R              &kp T                  &kp Y              &kp U              &kp I              &kp O              &kp P              &kp BSPC
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  TAB                A                  S                  D                  F                  G                      H                  J                  K                  L                  ñ                  ´(dead)
    &kp TAB            &kp A              &kp S              &kp D              &kp F              &kp G                  &kp H              &kp J              &kp K              &kp L              &kp SEMI           &kp SQT
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  tap=SHIFT hold=CTRL Z                 X                  C                  V                  B                      N                  M                  ,                  .                  -                  tap=SHIFT 2x=CAPS
    &mt_ctrl_shift LCTRL LSHIFT &kp Z    &kp X              &kp C              &kp V              &kp B                  &kp N              &kp M              &kp COMMA          &kp DOT            &kp FSLH           &td_shift_caps
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ALT                CMD                tap=SPC hold=FN        tap=ENT hold=FN    NUM                SYM
                                                             &kp LALT           &kp LGUI           &lt 3 SPACE            &lt 3 ENTER        &mo 1              &mo 2
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        // ====================================================================
        // LAYER 1: NUMBER — Numbers + Operators + nvim Navigation — spec 04
        // ====================================================================
        // Home row left:   + - * / =  (operators, Spanish macOS keycodes)
        // Home row right:  ← ↓ ↑ → HOME PGUP  (hjkl navigation)
        // Bottom row left: w← w→ gg G  (word/doc jumps)
        // Bottom row right: END PGDN line-start line-end
        // ====================================================================
        lower_layer {
            display-name = "NUMBER";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮    ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ---                1                  2                  3                  4                  5                       6                  7                  8                  9                  0                  BSPC
    &trans             &kp N1             &kp N2             &kp N3             &kp N4             &kp N5                  &kp N6             &kp N7             &kp N8             &kp N9             &kp N0             &kp BSPC
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤    ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                +                  -                  *                  /                  =                       ←                  ↓                  ↑                  →                  HOME               PGUP
    &trans             &kp RBKT           &kp FSLH           &kp LS(RBKT)       &kp LS(N7)         &kp LS(N0)              &kp LEFT           &kp DOWN           &kp UP             &kp RIGHT          &kp HOME           &kp PG_UP
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤    ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                w←(Opt+←)         w→(Opt+→)          gg(Cmd+↑)          G(Cmd+↓)           ---                     END                PGDN               ^(Cmd+←)           $(Cmd+→)           ---                ---
    &trans             &kp LA(LEFT)       &kp LA(RIGHT)      &kp LG(UP)         &kp LG(DOWN)       &trans                  &kp END            &kp PG_DN          &kp LG(LEFT)       &kp LG(RIGHT)      &trans             &trans
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤    ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                ---                     ---                held               ---
                                                             &trans             &trans             &trans                  &trans             &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯    ╰──────────────────┴──────────────────┴──────────────────╯
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        // ====================================================================
        // LAYER 2: SYMBOL — Direct symbols for Spanish macOS — spec 05
        // ====================================================================
        // All keycodes produce the correct character under Spanish macOS.
        // LA() = Option/Alt combo. NON_US_BSLH = ISO key (< / >).
        // ====================================================================
        raise_layer {
            display-name = "SYMBOL";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ---                <                  >                  !                  &                  |                      "                  '/"(tap dance)      `                  ~                  \                  BSPC
    &trans             &kp NON_US_BSLH    &kp LS(NON_US_BSLH) &kp LS(N1)       &kp LS(N6)         &kp LA(N1)             &kp LS(N2)         &td_quote          &kp LBKT           &kp LA(SEMI)       &kp LA(GRAVE)      &kp BSPC
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                {                  }                  [                  ]                  ?                      _                  -                  ;                  :                  (                  )
    &trans             &kp LA(SQT)        &kp LA(BSLH)        &kp LA(LBKT)      &kp LA(RBKT)       &kp LS(MINUS)          &kp LS(FSLH)       &kp FSLH           &kp LS(COMMA)      &kp LS(DOT)        &kp LS(N8)         &kp LS(N9)
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                @                  #                  =                  %                  ∅                      +                  *                  =>                 {|}                ---                ---
    &trans             &kp LA(N2)         &kp LA(N3)          &kp LS(N0)        &kp LS(N5)         &none                  &kp RBKT           &kp LS(RBKT)       &macro_arrow       &macro_block       &trans             &trans
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                SPC                    ENT                held               ---
                                                             &trans             &trans             &kp SPACE              &kp RET            &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        // ====================================================================
        // LAYER 3: FUNCTION — F1-F12 + Media + Mouse — spec 03
        // ====================================================================
        // Mouse consolidated on home row left.
        // Media keys on bottom row left.
        // BOOTLOADER removed — only accessible from SETTINGS.
        // ====================================================================
        layer_3 {
            display-name = "FUNCTION";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  STUDIO_UNLOCK      F1                 F2                 F3                 F4                 F5                     F6                 F7                 F8                 F9                 F10                F11
    &studio_unlock     &kp F1             &kp F2             &kp F3             &kp F4             &kp F5                 &kp F6             &kp F7             &kp F8             &kp F9             &kp F10            &kp F11
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                M1(left)           M2(mid)            M3(right)          MB4                MB5                    ---                ---                ---                ---                PRSC               F12
    &trans             &mkp LCLK          &mkp MCLK          &mkp RCLK          &mkp MB4           &mkp MB5               &trans             &trans             &trans             &trans             &kp PRINTSCREEN    &kp F12
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                ⏮                  ⏯                  ⏭                  MUTE               VOL_DN                 VOL_UP             SCRL_LOCK          PAUSE              SYS_RESET          ---                ---
    &trans             &kp C_PREV         &kp C_PP           &kp C_NEXT         &kp C_MUTE         &kp C_VOL_DN           &kp C_VOL_UP       &kp SCROLLLOCK     &kp PAUSE_BREAK    &sys_reset         &trans             &trans
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                held                   held               ---                ---
                                                             &trans             &trans             &trans                 &trans             &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        // ====================================================================
        // LAYER 4: SETTINGS — BT + RGB + Output + Bootloader — spec 03
        // ====================================================================
        // Activated via tri-layer: hold NUM (mo 1) + SYM (mo 2) simultaneously.
        // BOOTLOADER at bottom-right — hardest position to hit accidentally.
        // ====================================================================
        settings_layer {
            display-name = "SETTINGS";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ---                BT_CLR_ALL         BT_0               BT_1               BT_2               BT_3                   ---                ---                ---                ---                ---                ---
    &trans             &bt BT_CLR_ALL     &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3           &trans             &trans             &trans             &trans             &trans             &trans
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                RGB_TOG            RGB_EFF            RGB_EFR            RGB_SPI            RGB_BRI                RGB_BRD            ---                ---                ---                ---                ---
    &trans             &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &rgb_ug RGB_EFR    &rgb_ug RGB_SPI    &rgb_ug RGB_BRI        &rgb_ug RGB_BRD    &trans             &trans             &trans             &trans             &trans
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                OUT_USB            OUT_BLE            ---                ---                ---                    ---                ---                ---                BOOTLOADER         SYS_RESET          ---
    &trans             &out OUT_USB       &out OUT_BLE       &trans             &trans             &trans                 &trans             &trans             &trans             &bootloader        &sys_reset         &trans
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                ---                    ---                held               held
                                                             &trans             &trans             &trans                 &trans             &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
