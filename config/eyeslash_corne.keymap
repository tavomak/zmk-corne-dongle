/*
 * ╔══════════════════════════════════════════════════════════════════════════╗
 * ║                    Tavomak's CORNE KEYMAP CONFIGURATION                   ║
 * ╚══════════════════════════════════════════════════════════════════════════╝
 */

// ============================================================================
// CONFIGURACIÓN DE MOUSE/POINTING DEVICE
// ============================================================================
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // Velocidad de movimiento del mouse (default: 600)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25    // Velocidad de scroll (default: 10)

// ============================================================================
// INCLUDES - Librerías necesarias
// ============================================================================
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// ============================================================================
// CONFIGURACIÓN DE INPUT PROCESSORS
// ============================================================================
&mmv_input_listener { 
    input-processors = <&zip_xy_scaler 2 1>; 
};

&msc_input_listener { 
    input-processors = <&zip_scroll_scaler 2 1>; 
};

// ============================================================================
// CONFIGURACIÓN DE MOUSE SCROLL (msc)
// ============================================================================
&msc {
    acceleration-exponent = <1>;        // Exponente de aceleración (default: 0)
    time-to-max-speed-ms = <100>;       // Tiempo para alcanzar velocidad máxima (default: 300)
    delay-ms = <0>;                     // Delay antes de iniciar scroll (default: 0)
};

// ============================================================================
// CONFIGURACIÓN DE MOUSE MOVEMENT (mmv)
// ============================================================================
&mmv {
    time-to-max-speed-ms = <500>;       // Tiempo para alcanzar velocidad máxima
    acceleration-exponent = <1>;        // Exponente de aceleración
    trigger-period-ms = <16>;           // Período de actualización (60 FPS)
};


// ============================================================================
// DEFINICIÓN DE BEHAVIORS PERSONALIZADOS
// ============================================================================
/ {
    behaviors {
        // ------------------------------------------------------------------------
        // TAP DANCE: Shift/Caps Lock
        // Un toque = Shift | Dos toques = Caps Lock
        // ------------------------------------------------------------------------
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    // ------------------------------------------------------------------------
    // ENCODER RGB: Controla el brillo del RGB
    // Girar = Aumentar/Disminuir brillo
    // ------------------------------------------------------------------------
    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    // ------------------------------------------------------------------------
    // ENCODER SCROLL: Controla el scroll del mouse
    // Girar = Scroll arriba/abajo
    // ------------------------------------------------------------------------
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    // ========================================================================
    // KEYMAP - CAPAS DEL TECLADO
    // ========================================================================
    keymap {
        compatible = "zmk,keymap";

        // ====================================================================
        // CAPA 0: DEFAULT (QWERTY)
        // ====================================================================
        // Distribución estándar QWERTY con modificadores y acceso a capas
        // - td0: Tap Dance (Shift/Caps)
        // - mo 1: Momentary layer 1 (NUMBER)
        // - mo 2: Momentary layer 2 (SYMBOL)
        // - lt 3: Layer-tap 3 (Fn) con Space/Enter
        // ====================================================================
        default_layer {
            display-name = "BASE";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  TAB                Q                  W                  E                  R                  T                      Y                  U                  I                  O                  P                  BSPC
    &kp TAB            &kp Q              &kp W              &kp E              &kp R              &kp T                  &kp Y              &kp U              &kp I              &kp O              &kp P              &kp BSPC
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  SHFT/CAPS          A                  S                  D                  F                  G                      H                  J                  K                  L                  ;                  '
    &td0               &kp A              &kp S              &kp D              &kp F              &kp G                  &kp H              &kp J              &kp K              &kp L              &kp SEMI           &kp SQT
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  CTRL               Z                  X                  C                  V                  B                      N                  M                  ,                  .                  /                 ESC
    &kp LCTRL          &kp Z              &kp X              &kp C              &kp V              &kp B                  &kp N              &kp M              &kp COMMA          &kp DOT            &kp FSLH           &kp ESC
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           GUI                NUM                LT3/SPACE              LT3/ENTER          SYM                ALT
                                                             &kp LGUI           &mo 1              &lt 3 SPACE            &lt 3 ENTER        &mo 2              &kp RALT
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;  // Encoder: Control de volumen
        };

        // ====================================================================
        // CAPA 1: NUMBER (Números y Navegación)
        // ====================================================================
        // Activa con: mo 1 (mantener presionado)
        // - Números 0-9 en fila superior
        // - Bluetooth: BT_CLR_ALL, BT_SEL 0-3
        // - RGB: ON/OFF, Efectos, Velocidad, Brillo
        // - Navegación: Flechas, Home, End, Page Up/Down
        // ====================================================================
        lower_layer {
            display-name = "NUMBER";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮    ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ---                1                  2                  3                  4                  5                       6                  7                  8                  9                  0                  BSPC
    &trans             &kp N1             &kp N2             &kp N3             &kp N4             &kp N5                  &kp N6             &kp N7             &kp N8             &kp N9             &kp N0             &kp BSPC
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤    ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                BT_CLR             BT_0               BT_1               BT_2               BT_3                    LEFT               DOWN                UP                RIGHT              HOME               PG_UP
    &trans             &bt BT_CLR_ALL     &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3            &kp LEFT           &kp DOWN           &kp UP             &kp RIGHT          &kp HOME           &kp PG_UP
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤    ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                RGB_OFF            RGB_ON             ---                ---                RGB_EFF                 RGB_EFR            RGB_SPI            RGB_BRI            RGB_BRD            END                PG_DN
    &trans             &rgb_ug RGB_OFF    &rgb_ug RGB_ON     &trans             &trans             &rgb_ug RGB_EFF         &rgb_ug RGB_EFR    &rgb_ug RGB_SPI    &rgb_ug RGB_BRI    &rgb_ug RGB_BRD    &kp END            &kp PG_DN
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤    ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                ---                     INS                DEL                ---
                                                             &trans             &trans             &trans                  &kp INS            &kp DEL            &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯    ╰──────────────────┴──────────────────┴──────────────────╯
            >;
            sensor-bindings = <&scroll_encoder>;  // Encoder: Scroll
        };

        // ====================================================================
        // CAPA 2: SYMBOL (Símbolos)
        // ====================================================================
        // Activa con: mo 2 (mantener presionado)
        // - Símbolos: ! @ # $ % ^ & * ( )
        // - Símbolos de programación: - = [ ] \ ` _ + { } | ~
        // - Bluetooth: BT_CLR
        // - Output: USB/BLE toggle
        // ====================================================================
        raise_layer {
            display-name = "SYMBOL";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ---                !                  @                  #                  $                  %                      ^                  &                  *                  (                  )                BSPC
    &trans             &kp EXCL           &kp AT             &kp HASH           &kp DLLR           &kp PRCNT              &kp CARET          &kp AMPS           &kp ASTRK          &kp LPAR           &kp RPAR           &kp BSPC
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                BT_CLR             M_LEFT             M_MIDDLE           M_RIGHT            M_BTN4                 -                  =                  [                  ]                  \                  `
    &trans             &bt BT_CLR         &mkp LCLK          &mkp MCLK          &mkp RCLK          &mkp MB4               &kp MINUS          &kp EQUAL          &kp LBKT           &kp RBKT           &kp BSLH           &kp GRAVE
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                OUT_USB            OUT_BLE            ---                ---                M_BTN5                 _                  +                  {                  }                  |                  ~
    &trans             &out OUT_USB       &out OUT_BLE       &none              &none              &mkp MB5               &kp UNDER          &kp PLUS           &kp LBRC           &kp RBRC           &kp PIPE           &kp TILDE
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                SPACE                  ENTER              ---                ---
                                                             &trans             &trans             &kp SPACE              &kp RET            &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
            sensor-bindings = <&scroll_encoder>;  // Encoder: Scroll
        };

        // ====================================================================
        // CAPA 3: Fn (Funciones y Sistema)
        // ====================================================================
        // Activa con: lt 3 (layer-tap con Space/Enter)
        // - Teclas de función: F1-F12
        // - Sistema: Bootloader, System Reset, Studio Unlock
        // - Teclas especiales: Print Screen, Scroll Lock, Pause Break
        // ====================================================================
        layer_3 {
            display-name = "FUNCTION";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  STUDIO_UNLOCK      F1                 F2                 F3                 F4                 F5                     F6                 F7                 F8                 F9                F10                F11
    &studio_unlock     &kp F1             &kp F2             &kp F3             &kp F4             &kp F5                 &kp F6             &kp F7             &kp F8             &kp F9             &kp F10            &kp F11
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                ---                M_LEFT             M_MIDDLE           M_RIGHT            M_BTN4                 BOOTLOADER         M_LEFT             M_MIDDLE           M_RIGHT            PRTSCRN            F12
    &trans             &trans             &mkp LCLK          &mkp MCLK          &mkp RCLK          &mkp MB4               &bootloader        &mkp LCLK          &mkp MCLK          &mkp RCLK          &kp PRINTSCREEN    &kp F12
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                SYS_RESET          ---                BOOTLOADER         ---                M_BTN5                 ---                ---                BOOTLOADER         SYS_RESET          SCRLLOCK           PAUSE
    &trans             &sys_reset         &trans             &bootloader        &trans             &mkp MB5               &trans             &trans             &bootloader        &sys_reset         &kp SCROLLLOCK     &kp PAUSE_BREAK
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                ---                    ---                ---                ---
                                                             &trans             &trans             &trans                 &trans             &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
            sensor-bindings = <&scroll_encoder>;  // Encoder: Scroll
        };
    };
};