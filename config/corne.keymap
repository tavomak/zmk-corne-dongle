/*
 * ╔══════════════════════════════════════════════════════════════════════════╗
 * ║                    Tavomak's CORNE KEYMAP CONFIGURATION                  ║
 * ╠══════════════════════════════════════════════════════════════════════════╣
 * ║  5 layers: BASE · NUMBER · SYMBOL · FUNCTION · SETTINGS                 ║
 * ║  OS: macOS Spanish (Spain) — keycodes derived accordingly                ║
 * ║  Specs: .claude/specs/01–07                                              ║
 * ╚══════════════════════════════════════════════════════════════════════════╝
 */

// ============================================================================
// INCLUDES
// ============================================================================
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

// ============================================================================
// CAPS WORD — Spanish macOS keycodes
// ============================================================================
// - and _ live on FSLH here; the default UNDERSCORE would be ? under this layout.
// SEMI (ñ) keeps the word going, but ZMK only shifts A-Z: Ñ still needs Shift.
&caps_word {
    continue-list = <FSLH LS(FSLH) SEMI BACKSPACE DELETE>;
};

/ {

    // ========================================================================
    // MACROS — spec 07
    // ========================================================================
    macros {

        // => (JS arrow function)
        // Sends = then > under Spanish macOS
        macro_arrow: macro_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LS(N0)>, <&kp LS(NON_US_BSLH)>;
        };

        // {} with cursor inside (JS/CSS block)
        // Sends { then } then LEFT arrow
        macro_block: macro_block {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LA(SQT)>, <&kp LA(BSLH)>, <&kp LEFT>;
        };

        // ^ typed directly: Shift+LBKT is a dead key, SPACE commits it
        macro_caret: macro_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp LS(LBKT)>, <&kp SPACE>;
        };

        // Selects a BT profile AND leaves USB: BT_SEL alone keeps typing over USB
        macro_bt_sel: macro_bt_sel {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&out OUT_BLE>, <&macro_param_1to2>, <&bt BT_SEL MACRO_PLACEHOLDER>;
        };

        // Wrapper: hold-tap can't pass the two params &bt BT_CLR needs
        macro_bt_clr: macro_bt_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    // ========================================================================
    // BEHAVIORS — specs 02, 06
    // ========================================================================
    behaviors {

        // Tap = TAB / Hold = CTRL
        // flavor=balanced + require-prior-idle avoids CTRL on fast typing
        mt_ctrl_tab: mt_ctrl_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // Hold 2 s = unpair the ACTIVE profile / Tap = nothing
        // tap-preferred: only the timer triggers it, other keys can't
        hold_bt_clr: hold_bt_clr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2000>;
            bindings = <&macro_bt_clr>, <&none>;
        };

        // 1 tap = RSHIFT / 2 taps = CAPS_WORD — spec 06
        td_shift_caps: td_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHIFT>, <&caps_word>;
        };

        // 1 tap = ' / 2 taps = " — spec 06
        // MINUS = ' and LS(N2) = " under Spanish macOS
        td_quote: td_quote {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp MINUS>, <&kp LS(N2)>;
        };

        // 1 tap = ! / 2 taps = ¡ — Spanish macOS
        // LS(N1) = ! and EQUAL = ¡
        td_excl: td_excl {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LS(N1)>, <&kp EQUAL>;
        };

        // 1 tap = ? / 2 taps = ¿ — Spanish macOS
        // LS(MINUS) = ? and LS(EQUAL) = ¿
        td_quest: td_quest {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LS(MINUS)>, <&kp LS(EQUAL)>;
        };
    };

    // ========================================================================
    // TRI-LAYER: NUMBER (1) + SYMBOL (2) → SETTINGS (4) — spec 03
    // ========================================================================
    conditional_layers {
        compatible = "zmk,conditional-layers";
        settings_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    // ========================================================================
    // KEYMAP
    // ========================================================================
    keymap {
        compatible = "zmk,keymap";

        // ====================================================================
        // LAYER 0: BASE — specs 01, 02
        // ====================================================================
        // Thumb left:  ALT | CMD | SPACE/FN
        // Thumb right: ENTER/FN | NUM | SYM
        // Pinky left:  ESC (top) | TAB/CTRL (home) | SHIFT (bottom)
        // Pinky right: BSPC (top) | ´ (home) | SHIFT/CAPS (bottom)
        // ====================================================================
        default_layer {
            display-name = "BASE";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ESC                Q                  W                  E                  R                  T                      Y                  U                  I                  O                  P                  BSPC
    &kp ESC            &kp Q              &kp W              &kp E              &kp R              &kp T                  &kp Y              &kp U              &kp I              &kp O              &kp P              &kp BSPC
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  tap=TAB hold=CTRL A                  S                  D                  F                  G                      H                  J                  K                  L                  ñ                  ´(dead)
    &mt_ctrl_tab LCTRL TAB &kp A              &kp S              &kp D              &kp F              &kp G                  &kp H              &kp J              &kp K              &kp L              &kp SEMI           &kp SQT
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  SHIFT              Z                 X                  C                  V                  B                      N                  M                  ,                  .                  -                  tap=SHIFT 2x=CAPS
    &kp LSHIFT         &kp Z              &kp X              &kp C              &kp V              &kp B                  &kp N              &kp M              &kp COMMA          &kp DOT            &kp FSLH           &td_shift_caps
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ALT                CMD                tap=SPC hold=FN        tap=ENT hold=FN    NUM                SYM
                                                             &kp LALT           &kp LGUI           &lt 3 SPACE            &lt 3 ENTER        &mo 1              &mo 2
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
        };

        // ====================================================================
        // LAYER 1: NUMBER — Numbers + Operators + nvim Navigation — spec 04
        // ====================================================================
        // Home row left:   + - * / =  (operators, Spanish macOS keycodes)
        // Home row right:  ← ↓ ↑ → HOME PGUP  (hjkl navigation)
        // Bottom row left: w← w→ gg G  (word/doc jumps)
        // Bottom row right: END PGDN line-start line-end
        // ====================================================================
        lower_layer {
            display-name = "NUMBER";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮    ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ---                1                  2                  3                  4                  5                       6                  7                  8                  9                  0                  BSPC
    &none              &kp N1             &kp N2             &kp N3             &kp N4             &kp N5                  &kp N6             &kp N7             &kp N8             &kp N9             &kp N0             &kp BSPC
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤    ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                +                  -                  *                  /                  =                       ←                  ↓                  ↑                  →                  HOME               PGUP
    &none              &kp RBKT           &kp FSLH           &kp LS(RBKT)       &kp LS(N7)         &kp LS(N0)              &kp LEFT           &kp DOWN           &kp UP             &kp RIGHT          &kp HOME           &kp PG_UP
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤    ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                w←(Opt+←)         w→(Opt+→)          gg(Cmd+↑)          G(Cmd+↓)           ∅                       END                PGDN               ^(Cmd+←)           $(Cmd+→)           ∅                  ∅
    &none              &kp LA(LEFT)       &kp LA(RIGHT)      &kp LG(UP)         &kp LG(DOWN)       &none                   &kp END            &kp PG_DN          &kp LG(LEFT)       &kp LG(RIGHT)      &none              &none
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤    ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                ---                     ---                held               ---
                                                             &trans             &trans             &trans                  &trans             &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯    ╰──────────────────┴──────────────────┴──────────────────╯
            >;
        };

        // ====================================================================
        // LAYER 2: SYMBOL — Direct symbols for Spanish macOS — spec 05
        // ====================================================================
        // All keycodes produce the correct character under Spanish macOS.
        // LA() = Option/Alt combo. NON_US_BSLH = ISO key (< / >).
        // Left: opening/closing pairs, ! over ?. Right: quotes, operators.
        // ; and : sit on the BASE , and . keys, matching Shift+, and Shift+. here.
        // ====================================================================
        raise_layer {
            display-name = "SYMBOL";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ---                <                  >                  (                  )                  !/¡(td)                "                  '/"(td)            `                  ~                  \                  BSPC
    &none              &kp NON_US_BSLH    &kp LS(NON_US_BSLH) &kp LS(N8)        &kp LS(N9)        &td_excl               &kp LS(N2)         &td_quote          &kp LBKT           &kp LA(SEMI)       &kp LA(GRAVE)      &kp BSPC
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                {                  }                  [                  ]                  ?/¿(td)                |                  -                  +                  *                  /                  _
    &none              &kp LA(SQT)        &kp LA(BSLH)       &kp LA(LBKT)       &kp LA(RBKT)       &td_quest              &kp LA(N1)         &kp FSLH           &kp RBKT           &kp LS(RBKT)       &kp LS(N7)         &kp LS(FSLH)
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                @                  #                  &                  %                  $                      =                  =>                 ;                  :                  {|}                ^
    &none              &kp LA(N2)         &kp LA(N3)         &kp LS(N6)         &kp LS(N5)         &kp LS(N4)             &kp LS(N0)         &macro_arrow       &kp LS(COMMA)      &kp LS(DOT)        &macro_block       &macro_caret
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                SPC                    ENT                held               ---
                                                             &trans             &trans             &kp SPACE              &kp RET            &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
        };

        // ====================================================================
        // LAYER 3: FUNCTION — F1-F12 + Media + Mouse — spec 03
        // ====================================================================
        // Mouse consolidated on home row left.
        // Media keys on bottom row left.
        // BOOTLOADER removed — only accessible from SETTINGS.
        // ====================================================================
        layer_3 {
            display-name = "FUNCTION";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  STUDIO_UNLOCK      F1                 F2                 F3                 F4                 F5                     F6                 F7                 F8                 F9                 F10                F11
    &studio_unlock     &kp F1             &kp F2             &kp F3             &kp F4             &kp F5                 &kp F6             &kp F7             &kp F8             &kp F9             &kp F10            &kp F11
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                M1(left)           M2(mid)            M3(right)          MB4                MB5                    ---                ---                ---                ---                PRSC               F12
    &trans             &mkp LCLK          &mkp MCLK          &mkp RCLK          &mkp MB4           &mkp MB5               &trans             &trans             &trans             &trans             &kp PRINTSCREEN    &kp F12
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                ⏮                  ⏯                  ⏭                  MUTE               VOL_DN                 VOL_UP             SCRL_LOCK          PAUSE              ∅                  ---                ---
    &trans             &kp C_PREV         &kp C_PP           &kp C_NEXT         &kp C_MUTE         &kp C_VOL_DN           &kp C_VOL_UP       &kp SCROLLLOCK     &kp PAUSE_BREAK    &none              &trans             &trans
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                held                   held               ---                ---
                                                             &trans             &trans             &trans                 &trans             &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
        };

        // ====================================================================
        // LAYER 4: SETTINGS — Devices + RGB + Bootloader — spec 03
        // ====================================================================
        // Activated via tri-layer: hold NUM (mo 1) + SYM (mo 2) simultaneously.
        // Top row: keys 1-4 = BT profiles 0-3, key 5 = USB. Same spot as NUMBER digits.
        // Hold P for 2 s = unpair the ACTIVE profile. No clear-all on purpose.
        // Y = VCC on, for all parts: use it if the dongle OLED stays dark after flashing.
        // Reset behaviors run on the half that was pressed, hence one set per half.
        // The dongle has no keys: its bootloader needs the physical button.
        // ====================================================================
        settings_layer {
            display-name = "SETTINGS";
            bindings = <
// ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮   ╭──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────┬──────────────────╮
//  ---                BT 1               BT 2               BT 3               BT 4               USB                    VCC ON             ---                ---                ---                hold 2s=CLEAR      ---
    &none              &macro_bt_sel 0    &macro_bt_sel 1    &macro_bt_sel 2    &macro_bt_sel 3    &out OUT_USB           &ext_power EP_ON   &none              &none              &none              &hold_bt_clr 0 0   &none
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                RGB_TOG            RGB_EFF            RGB_EFR            RGB_SPI            RGB_BRI                RGB_BRD            ---                ---                ---                ---                ---
    &none              &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &rgb_ug RGB_EFR    &rgb_ug RGB_SPI    &rgb_ug RGB_BRI        &rgb_ug RGB_BRD    &none              &none              &none              &none              &none
// ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┼──────────────────┤
//  ---                SYS_RESET          BOOTLOADER         ---                ---                ---                    ---                ---                ---                BOOTLOADER         SYS_RESET          ---
    &none              &sys_reset         &bootloader        &none              &none              &none                  &none              &none              &none              &bootloader        &sys_reset         &none
// ╰──────────────────┴──────────────────┴──────────────────┼──────────────────┼──────────────────┼──────────────────┤   ├──────────────────┼──────────────────┼──────────────────┴──────────────────┴──────────────────┴──────────────────╯
//                                                           ---                ---                ---                    ---                held               held
                                                             &trans             &trans             &trans                 &trans             &trans             &trans
//                                                          ╰──────────────────┴──────────────────┴──────────────────╯   ╰──────────────────┴──────────────────┴──────────────────╯
            >;
        };
    };
};
